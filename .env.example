VITE_APP_TITLE=The Christening of L C. Cerdeno

# Local: relative /api/v1 is proxied by Vite to VITE_APP_URL (Laravel).
# Production: set the absolute backend API URL (see .env.production).
VITE_API_BASE_URL=/api/v1

# Local UI origin (Open Graph / meta). Optional in production builds.
VITE_FRONTEND_URL=http://localhost:3000

# Local only - must match Laravel APP_URL (used by Vite /api proxy).
# Not used in production builds.
VITE_APP_URL=http://localhost:8000

# Set to true once the backend exposes POST /api/v1/rsvp.
VITE_RSVP_USE_API=false

# Inbox that receives every RSVP via formsubmit.co. The first submission sends a
# one-time "Activate Form" email to this address; RSVPs arrive after activation.
# Leave empty to keep RSVPs only in the browser's localStorage (demo mode).
VITE_RSVP_EMAIL=jvacerdeno@gmail.com
